{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "noEmit": true,
    "types": [
      "bun",
      "react"
    ],
    "strict": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "index.ts",
    "App.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "server/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "e2e/serve.ts"
  ]
}
