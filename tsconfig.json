{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "noEmit": true,
    "types": ["node", "react"]
  },
  "include": ["index.ts", "App.tsx", "src/**/*.ts", "src/**/*.tsx", "server/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
