{
  // The apartment-search Worker: the Expo web app as static assets, the API, the D1 database and the
  // sync Workflow. Wrangler bundles the TypeScript entry; the Worker uses only web-standard APIs, so it
  // needs no Node.js compatibility.
  //   bun run deploy    builds the web app and deploys
  //   bun run dev       runs it locally with local D1 and Workflows (`bun run db:local` creates the tables)
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "apartment-search",
  "account_id": "c021a5b3eac3e4ea7b4afba9fd926223",
  "main": "../../server/cloudflare.ts",
  "compatibility_date": "2026-11-18",
  // The app's address. People sign in with an email code (server/auth.ts). workers.dev stays on for scripts
  // that send the app access token, such as the StreetEasy home sync.
  // Scheduled resyncs (server/nightly.ts): hourly; the hour in New York decides between the 1 AM nightly resync,
  // the daytime checks every two hours from 8 AM to 10 PM, and nothing.
  "triggers": { "crons": ["0 * * * *"] },
  "routes": [{ "pattern": "apartments.5thof6.com", "custom_domain": true }],
  "workers_dev": true,
  // No per-version preview URLs; they were off before the first deploy from this file.
  "preview_urls": false,
  // Which deployed version is running; cached search answers are kept per version, so a deploy that changes
  // how results are ranked is seen at once.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    // Links in alerts, and the Web Push sender identity. The matching VAPID_PRIVATE_KEY is a secret
    // (scripts/vapid-keys.ts makes a new pair).
    "APP_ORIGIN": "https://apartments.5thof6.com",
    "VAPID_SUBJECT": "https://apartments.5thof6.com",
    "VAPID_PUBLIC_KEY": "BEqgObx5SB7ysrlTUyjApv-fz0OsYCIBIX8IieSYCwD9zzqZNP17UPSC-1i2RVBbHGhpaL0evuQ8yomGmdssY68",
    // Sender of alerts and sign-in codes, on a domain with Email Routing or onboarded to Email Sending.
    "ALERT_EMAIL_FROM": "alerts@5thof6.com"
  },
  // Email alerts and sign-in codes, sent to ACCESS_ALLOWED_EMAILS. Sending works once 5thof6.com has Email
  // Routing on and those addresses are verified there, or the domain is onboarded to Email Sending.
  "send_email": [{ "name": "ALERT_EMAIL" }],
  // Every request reaches the Worker first, so sign-in also protects the web app's files.
  // The page and the app's code are served by Cloudflare itself, from its edge, without starting the Worker
  // (their headers are in web-build/_headers); an address that is not a file is the app's page, which routes it.
  // The Worker runs for the API, the public pages it renders, and the archive it keeps private.
  // It also runs for the home page, to write into it what search engines and link previews read.
  "assets": {
    "directory": "../../web-build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/llms.txt",
      "/api/*",
      "/health",
      "/robots.txt",
      "/sitemap.xml",
      "/rents",
      "/rents/*",
      "/blog",
      "/blog/*",
      "/data/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "APARTMENTS",
      "database_name": "apartment-search-observations",
      "database_id": "c1e92bda-ec98-44c0-a15f-750b20b24455",
      // Schema changes, applied in order by the deploy workflow (migrations/README.md).
      "migrations_dir": "migrations"
    }
  ],
  // The inventory file browsers search (server/inventory.ts, docs/architecture/search.md).
  "kv_namespaces": [{ "binding": "INVENTORY", "id": "428aeaed22f04716b19a151f6099e7bf" }],
  "workflows": [
    // The complete syncs: CityRealty, Openigloo and Zumper. The Workflow and class keep their original
    // CityRealty names, since renaming a Workflow creates a new one. One run at a time, because each
    // sync holds the refresh lock while it saves.
    { "binding": "SYNC_WORKFLOW", "name": "apartment-cityrealty-sync", "class_name": "CityRealtySync", "concurrency": { "limit": 1 } }
  ],
  // Per-person limits on the costly API routes (server/cloudflare.ts). Each Cloudflare location counts
  // separately, so they stop bursts rather than enforce an exact total.
  "ratelimits": [
    { "name": "SEARCH_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "LOOKUP_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "limits": { "cpu_ms": 30000 }, // full Zumper and CityRealty pages parse within one Workflow step
  // Workers Logs, and Issues: failures (uncaught errors, 5xx replies, error logs) grouped on the Worker's Issues
  // page. Kept here because a deploy from this file would otherwise turn Issues off.
  "observability": { "enabled": true, "issues": { "enabled": true } },
  // Stack traces in Workers Logs then point at the TypeScript source (server/log.ts writes them).
  "upload_source_maps": true
  // Secrets, set with `wrangler secret put`: ACCESS_ALLOWED_EMAILS (required for sign-in; comma-separated),
  // BETTER_AUTH_SECRET (turns on email-code sign-in; `openssl rand -base64 32`),
  // APP_ACCESS_TOKEN (for scripts) and VAPID_PRIVATE_KEY (alert notifications). Optional: TRAVELTIME_APP_ID, TRAVELTIME_API_KEY,
  // FREE_PARTNER_FEEDS_JSON. Local values go in deploy/cloudflare/.dev.vars (see .dev.vars.example).
}
