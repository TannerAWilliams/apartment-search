{
  // The apartment-search Worker: the Expo web app as static assets, the API, the D1 database and the
  // sync Workflow. Wrangler bundles the TypeScript entry. Before the first deploy from this file,
  // compare it with the live Worker's settings (workers.dev, routes) so the deploy changes only code.
  //   bun run deploy    builds the web app and deploys
  //   bun run dev       runs it locally with local D1 and Workflows (`bun run db:local` creates the tables)
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "apartment-search",
  "main": "../../server/cloudflare.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  // Every request reaches the Worker first, so the access token also protects the web app's files.
  "assets": { "directory": "../../web-build", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "APARTMENTS", "database_name": "apartment-search-observations", "database_id": "c1e92bda-ec98-44c0-a15f-750b20b24455" }
  ],
  "workflows": [
    // Runs the CityRealty, Openigloo and Zumper complete syncs. Its name is kept for the existing instances.
    { "binding": "CITYREALTY_SYNC", "name": "apartment-cityrealty-sync", "class_name": "CityRealtySync" }
  ],
  "limits": { "cpu_ms": 30000 }, // full Zumper and CityRealty pages parse within one Workflow step
  "observability": { "enabled": true }
  // Secrets, set with `wrangler secret put`: APP_ACCESS_TOKEN (required; must equal APARTMENT_BACKEND_KEY
  // on apartment-search-access). Optional: TRAVELTIME_APP_ID, TRAVELTIME_API_KEY, FREE_PARTNER_FEEDS_JSON.
  // Local values go in deploy/cloudflare/.dev.vars (see .dev.vars.example).
}
