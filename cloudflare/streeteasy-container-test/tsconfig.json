{
  // The probe Worker runs on Cloudflare's runtime, so it is checked against Cloudflare's own runtime types
  // (worker-configuration.d.ts, generated by `wrangler types`) instead of the app's browser and Bun types.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "files": ["worker.ts", "worker-configuration.d.ts", "../../types/strict-json.d.ts"]
}
