# API keys are server-only. Keep .env out of Git.
RENTCAST_API_KEY=
GOOGLE_ROUTES_API_KEY=

# Each page consumes a RentCast API request. Allowed range 1 to 3.
RENTCAST_MAX_PAGES=1

# Optional authorized partner JSON feeds. See the README for the schema.
PARTNER_FEEDS_JSON=

# Defaults to local-only. Use 0.0.0.0 for an on-device test on your own LAN.
HOST=127.0.0.1
PORT=3000
APP_ACCESS_TOKEN=

# Optional native API origin. Never put provider API keys in EXPO_PUBLIC_*.
# EXPO_PUBLIC_API_URL=https://your-protected-apartment-search-api.example
