# Optional authorized listing feeds that you can read at no API cost.
# See the README for the schema. Keep .env out of Git.
FREE_PARTNER_FEEDS_JSON=

# Optional TravelTime credentials for weekday-morning transit and driving estimates.
TRAVELTIME_APP_ID=
TRAVELTIME_API_KEY=

# Defaults to local-only. Use 0.0.0.0 for an on-device test on your own LAN.
HOST=127.0.0.1
PORT=3000
APP_ACCESS_TOKEN=

# Optional native API origin for address geocoding or configured free feeds.
# EXPO_PUBLIC_API_URL=https://your-protected-apartment-search-api.example
