# Optional authorized listing feeds that you can read at no API cost.
# See the README for the schema. Keep .env out of Git.
FREE_PARTNER_FEEDS_JSON=

# Native hosts can fetch directly; keep relay credentials configured for an optional later switch.
# Set to relay only when that separate retrieval service is needed and healthy.
LISTING_FETCH_TRANSPORT=direct

# Optional TravelTime credentials for weekday-morning transit and driving estimates.
TRAVELTIME_APP_ID=
TRAVELTIME_API_KEY=

# Defaults to local-only. Use 0.0.0.0 for an on-device test on your own LAN.
HOST=127.0.0.1
PORT=3000
APP_ACCESS_TOKEN=

# Optional native API origin for address geocoding or configured free feeds.
# EXPO_PUBLIC_API_URL=https://your-protected-apartment-search-api.example

# Optional existing PostgreSQL database; keep credentials out of version control.
# Without this value the Node server uses temporary process memory.
# DATABASE_URL=postgresql://...
