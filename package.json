{
  "name": "apartment-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "dev": "node --experimental-strip-types --env-file-if-exists=.env server/node.ts",
    "build:web": "expo export --platform web --output-dir web-build",
    "build": "npm run build:web && node --experimental-strip-types scripts/build-site.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run typecheck && npm run build:web && npm test && playwright test",
    "test:e2e:list": "playwright test --list"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "base64-js": "^1.5.1",
    "csv-parse": "^6.2.1",
    "expo": "~58.0.23",
    "fflate": "^0.8.3",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.3",
    "playwright": "1.65.0"
  }
}
