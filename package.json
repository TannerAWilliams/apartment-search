{
  "name": "apartment-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "start": "bun ./node_modules/expo/bin/cli start",
    "ios": "bun ./node_modules/expo/bin/cli start --ios",
    "android": "bun ./node_modules/expo/bin/cli start --android",
    "web": "bun ./node_modules/expo/bin/cli start --web",
    "dev": "bun server/main.ts",
    "serve": "bun server/main.ts",
    "inspect:streeteasy": "bun scripts/inspect-streeteasy.ts",
    "build:web": "bun ./node_modules/expo/bin/cli export --platform web --output-dir web-build",
    "build": "bun run build:web && bun scripts/build-site.ts",
    "test": "bun test ./test/*.test.ts",
    "test:coverage": "bun test --coverage ./test/*.test.ts && bun scripts/report-coverage.ts",
    "typecheck": "bun ./node_modules/typescript/bin/tsc --noEmit",
    "test:e2e": "bun run typecheck && bun run build:web && bun run test && bun ./node_modules/playwright/cli.js test",
    "test:e2e:list": "bun ./node_modules/playwright/cli.js test --list",
    "test:postgres": "bun test ./test/postgres-real.integration.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "base64-js": "^1.5.1",
    "csv-parse": "^7.0.0",
    "expo": "~58.0.23",
    "fflate": "^0.8.3",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/bun": "1.4.4",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "playwright": "1.65.1",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
