{
  "name": "apartment-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "dev": "node --env-file-if-exists=.env server/node.mjs",
    "build:web": "expo export --platform web --output-dir web-build",
    "build": "npm run build:web && node scripts/build-site.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "expo": "~58.0.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
